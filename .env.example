PORT=19080
DATABASE_PATH=./data/platform.db

# Qwen выключен, пока не заданы QWEN_API_KEY и QWEN_BASE_URL.
# Используйте локальный/закрытый OpenAI-compatible endpoint или выбранный
# регион Alibaba Cloud Model Studio. Не коммитьте реальный API-ключ.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_MS=60000
