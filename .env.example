# PostgreSQL connection string (requires pgvector extension for RAG embeddings)
# Docker:   postgresql://mik:mik_pass@localhost:5432/mik_platform  (after: docker compose up -d)
# Supabase: Settings → Database → Connection string → URI
# Local:    postgresql://postgres:password@localhost:5432/mik_platform
DATABASE_URL=

PORT=19080

# For RAG embeddings (text-embedding-3-small) and optional chat fallback
OPENAI_API_KEY=

# For RAG chat responses (claude-haiku-4-5-20251001 by default)
ANTHROPIC_API_KEY=

# Optional: override the LLM model used in KB chat (default: claude-haiku-4-5-20251001)
# KB_LLM_MODEL=claude-sonnet-4-6

# Supabase Storage — for persistent file storage (replaces local disk uploads)
# supabase.com → Project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Audio Text Assistant. These values are environment fallbacks and can be
# overridden from the admin-only tab in /admin.
IMOSCOW_MOCK_MODE=true
APP_ENV=development
AUTH_MODE=reverse_proxy
AUDIO_TEXT_ASSISTANT_SETUP_MODE=portal

# Set IMOSCOW_MOCK_MODE=false only after the i.moscow contracts and
# backend-only credentials below have been verified for the deployment.
TRANSCRIPTION_PROXY_CONTRACT_VERIFIED=false
SUMMARIZER_PROXY_CONTRACT_VERIFIED=false
IMOSCOW_BASE_URL=https://i.moscow
IMOSCOW_TRANSCRIPTION_OPERATION_PATH=/api/dit/proxy/operation/voice-log-server
IMOSCOW_UPLOAD_FIELD=file
IMOSCOW_SUMMARIZER_PROXY_URL=https://i.moscow/api/dit/proxy/operation/structurizer/invocations
IMOSCOW_PROXY_TOKEN=
IMOSCOW_PHPSESSID=
IMOSCOW_SESSION_COOKIE=

# Optional dedicated key for AES-256-GCM encryption of secrets stored from
# /admin. If omitted, APP_SECRET_KEY or DATABASE_URL is used as key material.
AUDIO_ASSISTANT_SETTINGS_KEY=

# Optional outside Docker; the Docker image already installs ffmpeg.
FFMPEG_PATH=ffmpeg
